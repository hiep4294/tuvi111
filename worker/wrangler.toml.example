name = "hiep-tuvi-ai"
main = "worker/index.js"
compatibility_date = "2026-09-01"

[vars]
ANTHROPIC_MODEL = "claude-sonnet-5-5"
OPENAI_MODEL = "gpt-5-mini"
DEFAULT_MODEL = "gemini-3.8-flash"
ALLOWED_MODELS = "gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash"
# Đổi thành origin GitHub Pages/domain thực tế để hạn chế lạm dụng Worker.
# Ví dụ: https://hiep4294.github.io
ALLOWED_ORIGIN = ""

# Lưu từng khóa cần dùng bằng Wrangler
# wrangler secret put ANTHROPIC_API_KEY
# wrangler secret put OPENAI_API_KEY
# wrangler secret put GEMINI_API_KEY
